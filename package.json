{
  "name": "ponto-facial",
  "private": true,
  "packageManager": "pnpm@9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev:mobile": "pnpm --filter mobile-repp dev",
    "dev:web": "pnpm --filter web-ptrp dev",
    "dev:pwa": "NODE_ENV=development pnpm --filter pwa dev",
    "build:web": "pnpm --filter web-ptrp build",
    "build:pwa": "pnpm --filter pwa build",
    "build:pwa:static": "BUILD_STATIC=true pnpm --filter pwa build",
    "build:all": "BUILD_STATIC=true pnpm --filter pwa build && pnpm --filter functions build",
    "deploy:pwa": "pnpm build:pwa:static && firebase deploy --only hosting",
    "deploy:all": "pnpm build:all && firebase deploy",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,storage:rules",
    "clean": "pnpm --filter pwa clean",
    "dev:clean": "pnpm clean && pnpm dev:pwa",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx || true",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix || true",
    "typecheck": "pnpm --filter pwa typecheck"
  }
}