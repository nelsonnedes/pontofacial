{
  "name": "pwa",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "cross-env NEXT_PRIVATE_OUTPUT_LINUX_PLATFORM=1 next build",
    "build:static": "next build",
    "build:firebase": "npm run clean && npm run build && npm run deploy:firebase",
    "start": "next start -p 3000",
    "preview": "npx serve out -l 3001",
    "clean": "rimraf .next out",
    "lint": "next lint --fix",
    "lint:check": "next lint",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.ts --pool=forks",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "deploy:firebase": "cd ../.. && firebase deploy --only hosting",
    "deploy:full": "cd ../.. && firebase deploy",
    "prebuild": "node scripts/validate-app-check-env.mjs && npm run clean"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "autoprefixer": "^10.4.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.8",
    "firebase": "^12.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.18",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-firebase-hooks": "^5.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.18",
    "fake-indexeddb": "^6.1.0",
    "jsdom": "^26.1.0",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  }
}
