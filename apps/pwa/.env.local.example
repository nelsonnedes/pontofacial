# Firebase Web App publico
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAcF2A3Y3Eq6sYJrHyD-kdIPJd5oRBlkdc
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dbponto-facial.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dbponto-facial
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dbponto-facial.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=19681620887
NEXT_PUBLIC_FIREBASE_APP_ID=1:19681620887:web:554c2528d592496130cad2
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-D4DQNPHJM3

# URLs para endpoints de assinatura (opcional durante dev)
NEXT_PUBLIC_SIGN_CADES_URL=http://localhost:8080/sign/cades
NEXT_PUBLIC_SIGN_PADES_URL=http://localhost:8080/sign/pades

# Firebase App Check
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Somente desenvolvimento local: token de debug gerado pelo App Check.
# Nunca configure este valor em builds de producao.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Perfil de release. Use "production" apenas no build/deploy oficial.
NEXT_PUBLIC_PONTO_FACIAL_RELEASE_PROFILE=development

# Biometria
# production aceita somente "server" ou "provider"; legacy-client e apenas desenvolvimento.
NEXT_PUBLIC_BIOMETRIC_ENGINE=legacy-client
NEXT_PUBLIC_BIOMETRIC_LIVENESS_REQUIRED=true
NEXT_PUBLIC_BIOMETRIC_MIN_SIMILARITY=0.75
NEXT_PUBLIC_BIOMETRIC_MIN_CONFIDENCE=0.85
NEXT_PUBLIC_BIOMETRIC_MIN_CANDIDATE_MARGIN=0.15
NEXT_PUBLIC_BIOMETRIC_REVIEW_SIMILARITY=0.65
NEXT_PUBLIC_ALLOW_BIOMETRIC_DEMO=false
NEXT_PUBLIC_ALLOW_MANUAL_LIVENESS=false
NEXT_PUBLIC_ALLOW_LEGACY_CLIENT_BIOMETRICS=false

# Versoes legais obrigatorias para aceite versionado
NEXT_PUBLIC_REQUIRED_APP_TERMS_VERSION=2026-05-24-app-terms-v1
NEXT_PUBLIC_REQUIRED_PRIVACY_NOTICE_VERSION=2026-05-24-privacy-notice-v1
NEXT_PUBLIC_REQUIRED_BIOMETRIC_NOTICE_VERSION=2026-05-24-biometric-notice-v1
NEXT_PUBLIC_REQUIRED_LEGAL_CONTENT_HASH=2026-05-24-legal-baseline
