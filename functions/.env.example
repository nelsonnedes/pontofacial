# Copie para functions/.env ou functions/.env.dbponto-facial antes do deploy.
# Ativa enforcement de Firebase App Check nas callable Functions e endpoints HTTP sensiveis.
# Use "true" somente depois de configurar App Check no Firebase Console e publicar a chave real no PWA.
PONTO_FACIAL_RELEASE_PROFILE=development
ENFORCE_APP_CHECK=false

# Opcional: consome tokens App Check para reduzir replay. Habilite depois de validar o fluxo em producao.
CONSUME_APP_CHECK_TOKEN=false

# Segredos obrigatorios em producao:
#   firebase functions:secrets:set TIME_RECORD_WEBHOOK_SECRET --project dbponto-facial
#   firebase functions:secrets:set LEGAL_SIGNATURE_PROVIDER_API_KEY --project dbponto-facial
# Para emulador/local, prefira functions/.secret.local. Nao coloque segredos reais neste arquivo.

# Origens adicionais liberadas no CORS, separadas por virgula.
ALLOWED_ORIGINS=

# LGPD/aceites. Em producao, deixe true para bloquear ponto facial sem aceite vigente.
REQUIRE_LEGAL_ACCEPTANCE_FOR_FACIAL=true
REQUIRE_SERVER_BIOMETRIC_VERIFICATION=false
REQUIRED_PRIVACY_NOTICE_VERSION=2026-05-24-privacy-notice-v1
REQUIRED_BIOMETRIC_NOTICE_VERSION=2026-05-24-biometric-notice-v1
REQUIRED_LEGAL_CONTENT_HASH=2026-05-24-legal-baseline

# Assinatura legal ICP-Brasil/provider externo
LEGAL_SIGNATURE_PROVIDER_URL=
LEGAL_SIGNATURE_PROVIDER_TIMEOUT_MS=30000
